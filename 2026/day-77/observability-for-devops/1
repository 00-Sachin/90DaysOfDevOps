server:
  http_listen_port: 9080

positions:
  filename: /tmp/promtail/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  - job_name: docker
    static_configs:
      - targets:
          - localhost
        labels:
          job: docker
          __path__: /var/lib/docker/containers/*/*-json.log
    pipeline_stages:
      - json:
          expressions:
            log: log
            stream: stream

      # Dynamic extraction targeting everything between the /containers/ blocks
      - regex:
          source: filename
          expression: '.*/containers/(?P<container_id>[a-f0-9]+)/.*'

      - labels:
          container_name: container_id
